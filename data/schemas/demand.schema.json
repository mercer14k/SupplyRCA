    },
    "sku": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Sku",
      "type": "string"
    },
    "market": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Market",
      "type": "string"
    },
    "supplier_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",

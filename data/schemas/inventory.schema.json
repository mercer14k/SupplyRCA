{
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "source_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Source Id",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "validation_status": {
      "const": "valid",
      "default": "valid",
      "title": "Validation Status",
      "type": "string"
    },
    "lineage": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Lineage",
      "type": "object"
    },
    "date": {
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "sku": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Sku",
      "type": "string"
    },
    "market": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Market",
      "type": "string"
    },
    "supplier_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Supplier Id",
      "type": "string"
    },
    "opening": {
      "minimum": 0,
      "title": "Opening",
      "type": "number"
    },
    "received": {
      "minimum": 0,
      "title": "Received",
      "type": "number"
    },
    "shipped": {
      "minimum": 0,
      "title": "Shipped",
      "type": "number"
    },
    "closing": {
      "minimum": 0,
      "title": "Closing",
      "type": "number"
    }
  },
  "required": [
    "id",
    "source_id",
    "ingested_at",
    "date",
    "sku",
    "market",
    "supplier_id",
    "opening",
    "received",
    "shipped",
    "closing"
  ],
  "title": "Inventory",
  "type": "object"
}

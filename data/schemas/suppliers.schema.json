{
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "source_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Source Id",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "validation_status": {
      "const": "valid",
      "default": "valid",
      "title": "Validation Status",
      "type": "string"
    },
    "lineage": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Lineage",
      "type": "object"
    },
    "name": {
      "maxLength": 120,
      "title": "Name",
      "type": "string"
    },
    "country": {
      "maxLength": 80,
      "title": "Country",
      "type": "string"
    }
  },
  "required": [
    "id",
    "source_id",
    "ingested_at",
    "name",
    "country"
  ],
  "title": "Supplier",
  "type": "object"
}
